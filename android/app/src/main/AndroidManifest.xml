<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: links to the site's pages open in the app once
                 Android has checked https://www.manteion.no/.well-known/
                 assetlinks.json (AndroidAssetLinksController). Not the
                 download page, the stored pictures or the built files. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.manteion.no" />
                <data android:path="/" />
                <data android:pathPrefix="/events" />
                <data android:pathPrefix="/messages" />
                <data android:pathPrefix="/users" />
                <data android:pathPrefix="/leaflets" />
                <data android:pathPrefix="/organizers" />
                <data android:pathPrefix="/notifications" />
                <data android:pathPrefix="/contacts" />
                <data android:pathPrefix="/settings" />
                <data android:pathPrefix="/login" />
                <data android:pathPrefix="/register" />
                <data android:pathPrefix="/forgot-password" />
                <data android:pathPrefix="/reset-password" />
            </intent-filter>
        </activity>

        <!-- Pushes from the site, through Firebase Cloud Messaging. -->
        <service
            android:name=".ManteionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Reply and Mark as read on a conversation's notification. -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_manteion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="direct_messages" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- The camera app, for a page's "take a photo" request: since Android
         11 an app only sees the other apps it says it looks for, and
         without this Capacitor falls back to the photo picker. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The calls channel vibrates with the ringtone. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Video calls: the page's getUserMedia() reaches Capacitor's WebView
         client, which asks the user for these and grants the request. A
         side effect since 1.3: the first "take a photo" asks for the
         camera too, as Capacitor requests a declared CAMERA permission
         before opening the camera app. Neither is required to install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- With a call's sound at the ear (AudioOutput, 1.6+) the screen goes
         dark near the face, as in a phone call. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
