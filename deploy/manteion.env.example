# Manteion's settings on the server: /home/manteion/manteion.env, owned by
# manteion with mode 600 (it holds the keys). Every release links its .env
# here. Lines marked "from the current site" are copied from the .env of the
# site on domene.shop (~/app/.env); the rest are made here.

APP_NAME=Manteion
APP_ENV=production
# From the current site: what was encrypted with it stays readable.
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.manteion.no

# From the current site, if it sets them.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One log file a day in /home/manteion/storage/logs, kept for two weeks.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

# The database is one SQLite file, outside the releases.
DB_CONNECTION=sqlite
DB_DATABASE=/home/manteion/database/manteion.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is only ever reached over https.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Push, mail and link previews wait here for the manteion-queue service.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail goes out through Resend over https (from the current site).
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Web push: from the current site, if it has them. Otherwise make a pair
# once, on the server:
#   sudo -u manteion php /home/manteion/app/artisan webpush:vapid --show
# and keep them: new keys cut every device's subscription off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@manteion.no

# Pushes to the Android app go through Firebase Cloud Messaging. The
# Firebase project's service-account key lives beside this file, readable
# by manteion only (see README.md, "Pushes to the Android app"). Left empty,
# the app gets no pushes and nothing else changes.
FCM_CREDENTIALS=/home/manteion/firebase-service-account.json
# Only if it should differ from the key file's own project_id.
FCM_PROJECT_ID=

# Reverb, the WebSocket server. Make your own values once:
#   openssl rand -hex 8    (REVERB_APP_ID)
#   openssl rand -hex 16   (REVERB_APP_KEY)
#   openssl rand -hex 32   (REVERB_APP_SECRET)
# deploy.sh refuses to run without them.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the app reaches Reverb: on the server itself.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Where browsers reach it: through Apache, at the site's own address.
REVERB_PUBLIC_HOST=www.manteion.no
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
# Only pages from the site itself may open a connection.
REVERB_ALLOWED_ORIGINS=www.manteion.no

# No server-side rendering here: the pages render in the browser.
INERTIA_SSR_ENABLED=false
